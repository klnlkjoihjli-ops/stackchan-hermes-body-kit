ADMIN_HOST=127.0.0.1
ADMIN_PORT=8787
ADMIN_USER=<admin-user>
ADMIN_PASSWORD=<strong-admin-password>
ADMIN_TITLE=StackChan Body Admin
PUBLIC_LABEL=<admin-domain.example.com>

